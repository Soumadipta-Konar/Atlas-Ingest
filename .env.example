# =============================================================================
# Atlas-Ingest — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# ── LLM API Keys (at least one required for batch-extract) ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── MongoDB (optional — only needed if you want database export) ────────────
# If not set, the pipeline exports CSV only and skips MongoDB entirely.
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/atlas_ingest

# ── GitHub (optional — for enriching research papers with star counts) ──────
# Without this, GitHub API will hit rate limits quickly.
# GITHUB_TOKEN=ghp_your_github_personal_access_token

# ── Dashboard Server (optional — only needed for client/server dashboard) ───
# API_SECRET protects the POST /api/run endpoint. Leave unset for dev mode.
# API_SECRET=your_secret_token_here
# CORS_ORIGIN=http://localhost:5173
# PORT=5000
